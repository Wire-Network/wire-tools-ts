{
  "extends": "../../etc/tsconfig/tsconfig.base.jest.json",
  "compilerOptions": {
    "rootDir": "tests",
    "outDir": "lib/out-tests",
    "strictNullChecks": true,
    "paths": {
      "@wireio/debugging-shared": ["../debugging-shared/src"],
      "@wireio/debugging-shared/*": ["../debugging-shared/src/*"],
      "@wireio/opp-stress-harness": ["../opp-stress-harness/src"],
      "@wireio/opp-stress-harness/*": ["../opp-stress-harness/src/*"],
      "@wireio/test-opp-stress": ["../opp-stress/src"],
      "@wireio/test-opp-stress/*": ["../opp-stress/src/*"],
      "@wireio/opp-swap-stress": ["./src"]
    }
  },
  "include": ["tests"],
  "references": [
    { "path": "../opp-stress/tsconfig.json" },
    { "path": "../opp-stress-harness/tsconfig.json" },
    { "path": "./tsconfig.src.json" }
  ]
}
