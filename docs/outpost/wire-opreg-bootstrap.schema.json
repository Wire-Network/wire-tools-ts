{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "label": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ],
      "description": "The cluster build label (^[a-z0-9_-]+$) — the WIRE_CLUSTER_LABEL of the create-wire-platform-cluster run that built the cluster, set by that workflow after a successful create; null when the cluster-tool writes the file"
    },
    "awsAccount": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "dev",
            "sandbox",
            "test",
            "prod"
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "The AWS account (environment) the cluster's nodes run in — awsClusterNodeConfig.account of the cluster config; null when the cluster has no AWS placement"
    },
    "operators": {
      "minItems": 1,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "accountName": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?:|[a-z1-5.]{0,11}[a-z1-5]|[a-z1-5.]{12}[a-j1-5])$",
                "description": "WIRE account name — the sysio.opreg::operators row key"
              },
              "type": {
                "description": "Operator type — always PRODUCER for this entry",
                "type": "string",
                "enum": [
                  "PRODUCER"
                ]
              },
              "keys": {
                "type": "object",
                "properties": {
                  "wire": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "K1",
                        "description": "Key type — always K1 in this slot"
                      },
                      "publicKey": {
                        "type": "string",
                        "pattern": "^PUB_K1_[0-9A-Za-z_-]+$",
                        "description": "Wire-canonical public key (PUB_K1_…)"
                      }
                    },
                    "required": [
                      "type",
                      "publicKey"
                    ],
                    "description": "WIRE account key (K1)"
                  },
                  "wireFinalizer": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "BLS",
                        "description": "Key type — always BLS in this slot"
                      },
                      "publicKey": {
                        "type": "string",
                        "pattern": "^PUB_BLS_[0-9A-Za-z_-]+$",
                        "description": "Wire-canonical public key (PUB_BLS_…)"
                      },
                      "proofOfPossession": {
                        "type": "string",
                        "pattern": "^SIG_BLS_[0-9A-Za-z_-]+$",
                        "description": "BLS proof of possession (SIG_BLS_…)"
                      }
                    },
                    "required": [
                      "type",
                      "publicKey",
                      "proofOfPossession"
                    ],
                    "description": "WIRE finality key (BLS)"
                  }
                },
                "required": [
                  "wire",
                  "wireFinalizer"
                ],
                "additionalProperties": false,
                "description": "A producer's public keys: the WIRE account key and the WIRE finality key"
              }
            },
            "required": [
              "accountName",
              "type",
              "keys"
            ],
            "description": "A bootstrapped producer"
          },
          {
            "type": "object",
            "properties": {
              "accountName": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?:|[a-z1-5.]{0,11}[a-z1-5]|[a-z1-5.]{12}[a-j1-5])$",
                "description": "WIRE account name — the sysio.opreg::operators row key"
              },
              "type": {
                "description": "Operator type — always BATCH for this entry",
                "type": "string",
                "enum": [
                  "BATCH"
                ]
              },
              "keys": {
                "type": "object",
                "properties": {
                  "wire": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "K1",
                        "description": "Key type — always K1 in this slot"
                      },
                      "publicKey": {
                        "type": "string",
                        "pattern": "^PUB_K1_[0-9A-Za-z_-]+$",
                        "description": "Wire-canonical public key (PUB_K1_…)"
                      }
                    },
                    "required": [
                      "type",
                      "publicKey"
                    ],
                    "description": "WIRE account key (K1)"
                  },
                  "ethereum": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "EM",
                        "description": "Key type — always EM in this slot"
                      },
                      "publicKey": {
                        "type": "string",
                        "pattern": "^PUB_EM_[0-9A-Za-z_-]+$",
                        "description": "Wire-canonical public key (PUB_EM_…)"
                      },
                      "address": {
                        "type": "string",
                        "pattern": "^0x[0-9a-fA-F]{40}$",
                        "description": "EVM address of the key (0x…)"
                      }
                    },
                    "required": [
                      "type",
                      "publicKey",
                      "address"
                    ],
                    "description": "Ethereum key (EM)"
                  },
                  "solana": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "ED",
                        "description": "Key type — always ED in this slot"
                      },
                      "publicKey": {
                        "type": "string",
                        "pattern": "^PUB_ED_[0-9A-Za-z_-]+$",
                        "description": "Wire-canonical public key (PUB_ED_…)"
                      },
                      "address": {
                        "type": "string",
                        "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$",
                        "description": "Solana address of the key (base58 public key)"
                      }
                    },
                    "required": [
                      "type",
                      "publicKey",
                      "address"
                    ],
                    "description": "Solana key (ED)"
                  }
                },
                "required": [
                  "wire",
                  "ethereum",
                  "solana"
                ],
                "additionalProperties": false,
                "description": "A batch operator's or underwriter's public keys: the WIRE account key and its Ethereum and Solana keys"
              }
            },
            "required": [
              "accountName",
              "type",
              "keys"
            ],
            "description": "A bootstrapped batch operator"
          },
          {
            "type": "object",
            "properties": {
              "accountName": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?:|[a-z1-5.]{0,11}[a-z1-5]|[a-z1-5.]{12}[a-j1-5])$",
                "description": "WIRE account name — the sysio.opreg::operators row key"
              },
              "type": {
                "description": "Operator type — always UNDERWRITER for this entry",
                "type": "string",
                "enum": [
                  "UNDERWRITER"
                ]
              },
              "keys": {
                "type": "object",
                "properties": {
                  "wire": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "K1",
                        "description": "Key type — always K1 in this slot"
                      },
                      "publicKey": {
                        "type": "string",
                        "pattern": "^PUB_K1_[0-9A-Za-z_-]+$",
                        "description": "Wire-canonical public key (PUB_K1_…)"
                      }
                    },
                    "required": [
                      "type",
                      "publicKey"
                    ],
                    "description": "WIRE account key (K1)"
                  },
                  "ethereum": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "EM",
                        "description": "Key type — always EM in this slot"
                      },
                      "publicKey": {
                        "type": "string",
                        "pattern": "^PUB_EM_[0-9A-Za-z_-]+$",
                        "description": "Wire-canonical public key (PUB_EM_…)"
                      },
                      "address": {
                        "type": "string",
                        "pattern": "^0x[0-9a-fA-F]{40}$",
                        "description": "EVM address of the key (0x…)"
                      }
                    },
                    "required": [
                      "type",
                      "publicKey",
                      "address"
                    ],
                    "description": "Ethereum key (EM)"
                  },
                  "solana": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "ED",
                        "description": "Key type — always ED in this slot"
                      },
                      "publicKey": {
                        "type": "string",
                        "pattern": "^PUB_ED_[0-9A-Za-z_-]+$",
                        "description": "Wire-canonical public key (PUB_ED_…)"
                      },
                      "address": {
                        "type": "string",
                        "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$",
                        "description": "Solana address of the key (base58 public key)"
                      }
                    },
                    "required": [
                      "type",
                      "publicKey",
                      "address"
                    ],
                    "description": "Solana key (ED)"
                  }
                },
                "required": [
                  "wire",
                  "ethereum",
                  "solana"
                ],
                "additionalProperties": false,
                "description": "A batch operator's or underwriter's public keys: the WIRE account key and its Ethereum and Solana keys"
              }
            },
            "required": [
              "accountName",
              "type",
              "keys"
            ],
            "description": "A bootstrapped underwriter"
          }
        ],
        "description": "One operator registered on sysio.opreg with is_bootstrapped"
      },
      "description": "Every bootstrapped operator, ordered by operator type then account name"
    },
    "chains": {
      "type": "object",
      "properties": {
        "ETHEREUM": {
          "type": "object",
          "properties": {
            "epochDurationSec": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "description": "The chain's minimum consensus epoch duration in seconds, the least time between two of its envelopes (its sysio.epoch::epochcfg.epoch_duration_sec)"
            },
            "batchOperatorGroups": {
              "type": "object",
              "properties": {
                "activeGroupIndex": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "Index into groups of the first active group — the chain's sysio.epoch epochstate.current_batch_op_group when the file is written (0: the front of the window is always the current group)"
                },
                "groups": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^(?:|[a-z1-5.]{0,11}[a-z1-5]|[a-z1-5.]{12}[a-j1-5])$",
                      "description": "WIRE account name"
                    }
                  },
                  "description": "The chain's batch-operator window in slot order (its sysio.epoch epochstate.batch_op_groups): groups[k] serves the chain's epoch k + 1; each member is the accountName of a BATCH operator in operators"
                }
              },
              "required": [
                "activeGroupIndex",
                "groups"
              ],
              "description": "One outpost chain's initial batch-operator schedule, built by sysio.epoch::schbatchgps"
            }
          },
          "required": [
            "epochDurationSec",
            "batchOperatorGroups"
          ],
          "description": "One outpost chain's consensus epoch duration and initial batch-operator schedule"
        },
        "SOLANA": {
          "type": "object",
          "properties": {
            "epochDurationSec": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "description": "The chain's minimum consensus epoch duration in seconds, the least time between two of its envelopes (its sysio.epoch::epochcfg.epoch_duration_sec)"
            },
            "batchOperatorGroups": {
              "type": "object",
              "properties": {
                "activeGroupIndex": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "Index into groups of the first active group — the chain's sysio.epoch epochstate.current_batch_op_group when the file is written (0: the front of the window is always the current group)"
                },
                "groups": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^(?:|[a-z1-5.]{0,11}[a-z1-5]|[a-z1-5.]{12}[a-j1-5])$",
                      "description": "WIRE account name"
                    }
                  },
                  "description": "The chain's batch-operator window in slot order (its sysio.epoch epochstate.batch_op_groups): groups[k] serves the chain's epoch k + 1; each member is the accountName of a BATCH operator in operators"
                }
              },
              "required": [
                "activeGroupIndex",
                "groups"
              ],
              "description": "One outpost chain's initial batch-operator schedule, built by sysio.epoch::schbatchgps"
            }
          },
          "required": [
            "epochDurationSec",
            "batchOperatorGroups"
          ],
          "description": "One outpost chain's consensus epoch duration and initial batch-operator schedule"
        }
      },
      "required": [
        "ETHEREUM",
        "SOLANA"
      ],
      "description": "Every outpost chain's consensus epoch, keyed by its sysio.chains code: each chain runs its own epoch counter, duration and batch-operator schedule"
    }
  },
  "required": [
    "label",
    "awsAccount",
    "operators",
    "chains"
  ],
  "title": "WIRE opreg bootstrap",
  "description": "The cluster's build label and AWS account, the bootstrapped operator roster (every sysio.opreg operator registered with is_bootstrapped: WIRE account name, operator type, public keys) and, for each outpost chain, its consensus epoch duration and the initial batch-operator schedule sysio.epoch::schbatchgps built for it, written by the cluster-tool bootstrap to <clusterPath>/wire-opreg-bootstrap.json."
}
